<?xml version="1.0" encoding="UTF-8"?>
<web-app>

	<!-- Filter Declarations -->
	<filter>
		<filter-name>FilterLogger</filter-name>
		<filter-class>simpleservlet.FilterLogger</filter-class>
		<init-param>
			<param-name>folder</param-name>
			<param-value>C:\temp\logs\</param-value>
		</init-param>
	</filter>

	<!-- Filter Mappings -->
	<filter-mapping>
		<filter-name>FilterLogger</filter-name>
		<url-pattern>/default</url-pattern>
	</filter-mapping>

	<!-- Welcome Files -->
	<welcome-file-list>
		<welcome-file>index</welcome-file>
	</welcome-file-list>

	<!-- Servlet Declarations -->
	<servlet>
		<servlet-name>ServletIndex</servlet-name>
		<jsp-file>/WEB-INF/jsp/index.jsp</jsp-file>
	</servlet>
	<servlet>
		<servlet-name>ServletDefault</servlet-name>
		<jsp-file>/WEB-INF/jsp/result.jsp</jsp-file>
		<multipart-config>
			<location>C:\temp\</location>
		</multipart-config>
	</servlet>
	<servlet>
		<servlet-name>ServletDumpMedia</servlet-name>
		<servlet-class>simpleservlet.ServletDumpMedia</servlet-class>
		<multipart-config>
			<location>C:\temp\</location>
		</multipart-config>
	</servlet>

	<!-- Filter Mapping -->
	<servlet-mapping>
		<servlet-name>ServletIndex</servlet-name>
		<url-pattern>/index</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>ServletDefault</servlet-name>
		<url-pattern>/default</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>ServletDumpMedia</servlet-name>
		<url-pattern>/dumpmedia</url-pattern>
	</servlet-mapping>

</web-app>